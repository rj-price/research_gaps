# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Optional: attribution shown on the OpenRouter activity dashboard
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Research Gap Identifier

# How PDFs reach the model.
#   auto    - docling if installed, else pypdf (default)
#   docling - layout-aware Markdown: real tables, headings, OCR (needs requirements-docling.txt)
#   text    - pypdf's text layer; no extra dependencies
#   native  - send the PDF to OpenRouter's file-parser plugin
PDF_MODE=auto
# Only used when PDF_MODE=native: pdf-text (free), mistral-ocr, or native
PDF_ENGINE=pdf-text

# Optional: raises the PubMed rate limit from 3 to 10 requests/second
NCBI_API_KEY=

# Digest delivery by email (only needed if "email" is in the watchlist's delivery list)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=

# Digest delivery by push (only needed if "push" is in the delivery list)
NTFY_URL=
NTFY_TOKEN=

# Evals: the judge model for the gap analysis suite (any OpenRouter model ID).
# Keep it different from the model under test - a model grading itself flatters itself.
# Some routes refuse plant-pathology prose about virulence and effectors; check a new
# judge on a few calls before trusting it (see the Evals section of README.md).
EVAL_JUDGE_MODEL=openai/gpt-5.6-terra
